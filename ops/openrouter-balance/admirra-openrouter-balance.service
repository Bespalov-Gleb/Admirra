[Unit]
Description=AdMirra OpenRouter account balance notifications
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/admirra/openrouter-balance/management-key

[Service]
Type=oneshot
DynamicUser=yes
StateDirectory=admirra-openrouter-balance
StateDirectoryMode=0700
LoadCredential=config:/etc/admirra/openrouter-balance/config.json
LoadCredential=management-key:/etc/admirra/openrouter-balance/management-key
LoadCredential=telegram-token:/etc/admirra/registration-notifier/bot-token
ExecStart=/usr/bin/python3 /opt/admirra-openrouter-balance/monitor.py
TimeoutStartSec=90
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_INET AF_UNIX
IPAddressDeny=any
IPAddressAllow=10.78.0.3/32
MemoryMax=64M
CPUQuota=10%
TasksMax=8
