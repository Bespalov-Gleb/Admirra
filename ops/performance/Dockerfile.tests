ARG BASE_IMAGE
FROM ${BASE_IMAGE}
USER root
# Isolated test derivative only. Never deploy this artifact to production.
RUN rm -rf /app/.env /app/secrets /app/uploads
COPY ops/api2_canary/build_overlay.py /tmp/api-only-test.py
RUN python /tmp/api-only-test.py && rm /tmp/api-only-test.py
COPY tests/ /app/tests/
COPY ops/run_isolated_tests.py /app/ops/run_isolated_tests.py
COPY automation/work_tables.py automation/work_ledger.py /app/automation/
COPY core/job_fence.py /app/core/job_fence.py
